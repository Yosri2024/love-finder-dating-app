# Local web dev (default) — copy to .env and adjust, or export VITE_API_URL
VITE_API_URL=http://localhost:8081/api

# --- Examples (uncomment the one you need, then `npm run build`) ---
# Test APK on same Wi-Fi as your PC (backend must listen on LAN, CORS allows it):
# VITE_API_URL=http://192.168.1.50:8081/api
# Production (backend hosted with HTTPS):
# VITE_API_URL=https://mon-backend.com/api
